{
  "extends": [
    "config:recommended",
    "github>cujarrett/homelab//.github/renovate-shared"
  ],
  "assignees": ["cujarrett"],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/sidecar/Dockerfile/"
      ],
      "matchStrings": [
        "SPIRE_VERSION=(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "spiffe/spire",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["spiffe/spire"],
      "prBodyNotes": [
        "⚠️ **Before merging:** check this version against the cluster's SPIRE version (`kubectl exec -n spire-server spire-server-0 -- /opt/spire/bin/spire-server --version`). Merging bumps the pinned `spire-agent` binary and rolls affected pods."
      ],
      "automerge": false
    }
  ]
}
